# Copy to .env and fill in what you need.  Only the provider you select is required.

# ---- LLM provider ---------------------------------------------------------
# openai | anthropic | deepseek | openrouter | ollama | openai_compatible | fake
WEBPILOT_PROVIDER=openai
WEBPILOT_MODEL=gpt-4.1-mini

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Local models (Ollama / vLLM / llama.cpp / LM Studio) expose an OpenAI-compatible API:
# WEBPILOT_PROVIDER=ollama
# WEBPILOT_MODEL=qwen3:8b
# WEBPILOT_BASE_URL=http://localhost:11434/v1
# WEBPILOT_BASE_URL=http://localhost:8000/v1

# ---- browser --------------------------------------------------------------
# 1 = invisible browser (tests/CI), 0 = visible browser (default)
WEBPILOT_HEADLESS=0
# WEBPILOT_BROWSER_CHANNEL=chrome
# WEBPILOT_PROFILE_DIR=~/.webpilot/profile      # persistent profile (logins survive)
# WEBPILOT_WINDOW_SIZE=1440x900
# extra Chrome flags, space separated:
# WEBPILOT_BROWSER_ARGS=--ozone-platform=x11 --window-position=2560,0

# ---- run ------------------------------------------------------------------
# WEBPILOT_MAX_STEPS=60
# WEBPILOT_PAGE_BUDGET=2600        # tokens per page snapshot handed to the model
# WEBPILOT_CONTEXT_BUDGET=60000    # total prompt budget
# WEBPILOT_TRANSCRIPT_DIR=~/.webpilot/transcripts

# ---- safety ---------------------------------------------------------------
# ask | allow | deny - how to treat destructive actions (payment, delete, send)
WEBPILOT_CONFIRM_MODE=ask
# domains whose destructive actions need no confirmation, comma separated:
# WEBPILOT_AUTO_APPROVE_DOMAINS=shop.example.com
